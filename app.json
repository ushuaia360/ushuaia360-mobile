{
  "expo": {
    "name": "Ushuaia360",
    "slug": "ushuaia360",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ushuaia360",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ushuaia360.ios",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Ushuaia360 usa tu ubicación para mostrarte en el mapa mientras hacés un sendero.",
        "NSPhotoLibraryUsageDescription": "Ushuaia360 necesita acceso a tus fotos para que puedas adjuntar imágenes a tus reseñas y guardar fondos de pantalla.",
        "NSPhotoLibraryAddUsageDescription": "Ushuaia360 guarda fondos de pantalla en tu galería de fotos.",
        "NSCameraUsageDescription": "Ushuaia360 puede usar la cámara si elegís sacar una foto para tu reseña."
      }
    },
    "android": {
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "blockedPermissions": [
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_AUDIO",
        "READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.ushuaia360"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.293853976567-837imlpvmvgc17he7ros766qk4a6sr05"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Ushuaia360 usa tu ubicación para mostrarte en el mapa y grabar tu recorrido mientras hacés un sendero, incluso con la app en segundo plano.",
          "locationAlwaysPermission": "Ushuaia360 sigue grabando tu recorrido en segundo plano mientras estás haciendo un sendero.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-task-manager",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ushuaia360 necesita acceso a tus fotos para que puedas adjuntar imágenes a tus reseñas.",
          "cameraPermission": "Ushuaia360 puede usar la cámara si elegís sacar una foto para tu reseña."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Ushuaia360 necesita acceso a tus fotos para guardar fondos de pantalla.",
          "savePhotosPermission": "Ushuaia360 guarda fondos de pantalla en tu galería de fotos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Inter",
                "fontDefinitions": [
                  { "path": "./assets/fonts/Inter-Light.ttf", "weight": 300 },
                  { "path": "./assets/fonts/Inter-Regular.ttf", "weight": 400 },
                  { "path": "./assets/fonts/Inter-Medium.ttf", "weight": 500 },
                  { "path": "./assets/fonts/Inter-SemiBold.ttf", "weight": 600 },
                  { "path": "./assets/fonts/Inter-Bold.ttf", "weight": 700 },
                  { "path": "./assets/fonts/Inter-ExtraBold.ttf", "weight": 800 }
                ]
              }
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}
